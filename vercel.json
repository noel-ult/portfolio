{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/search", "destination": "/projects", "permanent": true },
    { "source": "/github", "destination": "/projects", "permanent": true },
    { "source": "/now", "destination": "/about", "permanent": true },
    { "source": "/certificates", "destination": "/about#recognition-heading", "permanent": true },
    { "source": "/journal", "destination": "/projects", "permanent": true },
    { "source": "/journal/offline-llm-ollama", "destination": "/projects/local-ai-assistant", "permanent": true },
    { "source": "/journal/robotics-internship-ieee", "destination": "/experience", "permanent": true },
    {
      "source": "/journal/lessons-etlab-plus",
      "destination": "/projects/etlab-plus",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "intro", "value": "1" }],
      "destination": "/enter",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "portfolio-three-puce-77\\.vercel\\.app" }],
      "destination": "https://noelbiju.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portfolio-three-puce-77\\.vercel\\.app" }],
      "destination": "https://noelbiju.in/:path*",
      "permanent": true
    },
    {
      "source": "/opengraph-image",
      "destination": "https://noelbiju.in/profile/noel-biju.webp",
      "permanent": true
    }
  ]
}
